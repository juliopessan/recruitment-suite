<!DOCTYPE html>
<html lang="{{ language[:2] }}">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{{ 'report.title' | t(language) }} — {{ candidate_name }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  /* ==================================================================
     Editorial paper + terminal ledger.
     Paper ground, editorial ink, monospace for anything that is data.
     Square corners, hairline rules, two signal colours:
     rust = cost/risk, mint = pass. No shadows.
     ================================================================== */
  :root{
    --paper:#f3f0e7; --paper-50:#f8f6f0; --paper-200:#ebe7da;
    --ink:#14140f; --ink-700:#2b2a22; --ink-500:#57544a; --ink-400:#7c786c; --ink-300:#a3a094;
    --panel:#161615; --panel-600:#2a2a27;
    --rust:#d2542a; --rust-600:#b44320; --rust-50:#fdf3ef;
    --mint:#8ed4a4; --mint-600:#57ab74; --mint-700:#3d8154; --mint-50:#f0f9f3;
    --ochre:#c08a2e; --ochre-600:#a06f22; --ochre-50:#fbf5e8;
    --line:rgba(20,20,15,.15); --line-soft:rgba(20,20,15,.10);
    --line-dark:rgba(255,255,255,.10);
    --sans:'Archivo',system-ui,-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;
    --serif:'Instrument Serif',Georgia,'Times New Roman',serif;
    --mono:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{font-family:var(--sans);color:var(--ink);background:var(--paper);line-height:1.6;
    -webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}
  .wrap{max-width:1000px;margin:0 auto;padding:0 32px}
  ul{list-style:none}
  b,strong{font-weight:700}

  /* ---------- Shared type ---------- */
  .eyebrow{font-family:var(--mono);font-size:11px;font-weight:500;letter-spacing:.16em;
    text-transform:uppercase;color:var(--ink-400)}
  .rule-eyebrow{display:inline-flex;align-items:center;gap:12px}
  .rule-eyebrow::before{content:"";display:block;width:40px;height:1px;background:currentColor;opacity:.4}
  .serif-em{font-family:var(--serif);font-style:italic;font-weight:400;letter-spacing:-.01em}
  .mono{font-family:var(--mono);font-variant-numeric:tabular-nums}
  .chip{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line);
    padding:6px 12px;font-family:var(--mono);font-size:11px;letter-spacing:.16em;
    text-transform:uppercase;color:var(--ink-500)}

  section{padding:56px 0;border-bottom:1px solid var(--line)}
  h2.h{font-size:clamp(24px,3vw,32px);font-weight:800;letter-spacing:-.02em;line-height:1.05;margin:16px 0 12px}
  h2.h .serif-em{display:block;font-weight:400}
  .section-intro{font-size:15px;color:var(--ink-500);max-width:62ch;margin-bottom:32px}

  /* ---------- Masthead ---------- */
  .masthead{border-bottom:1px solid var(--line);padding:28px 0}
  .masthead .wrap{display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}
  .wordmark{display:inline-flex;align-items:center;gap:10px}
  .wordmark .mark{width:26px;height:26px;background:var(--ink);color:var(--paper);
    display:grid;place-items:center;font-weight:800;font-size:16px;line-height:1}
  .wordmark .name{font-weight:800;text-transform:uppercase;letter-spacing:.14em;font-size:14px}

  /* ---------- Hero ---------- */
  .hero{padding:64px 0 56px;border-bottom:1px solid var(--line)}
  .hero h1{font-size:clamp(38px,6vw,64px);font-weight:800;letter-spacing:-.03em;line-height:1.0;margin:24px 0 12px}
  .hero .role{font-family:var(--serif);font-style:italic;font-size:clamp(20px,2.6vw,28px);color:var(--ink-500)}
  .hero-meta{margin-top:28px;display:flex;flex-wrap:wrap;gap:10px}

  /* ---------- Verdict ledger ---------- */
  .ledger{background:var(--panel);color:var(--paper);border:1px solid var(--panel-600);padding:32px}
  .ledger-head{display:flex;align-items:center;justify-content:space-between;gap:16px;
    flex-wrap:wrap;margin-bottom:28px}
  .panel-label{font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;
    color:rgba(255,255,255,.45)}
  .verdict{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap;margin-bottom:28px}
  .verdict .fig{font-family:var(--mono);font-variant-numeric:tabular-nums;font-weight:700;
    font-size:64px;line-height:.9;letter-spacing:-.03em;color:#fff}
  .verdict .fig .of{font-size:20px;color:rgba(255,255,255,.4)}
  .verdict .status{font-family:var(--mono);font-weight:700;font-size:30px;letter-spacing:-.01em;text-align:right}
  .lrow{margin-bottom:20px}
  .lrow:last-child{margin-bottom:0}
  .lrow .top{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:10px}
  .lrow .val{font-family:var(--mono);font-variant-numeric:tabular-nums;font-weight:700;font-size:22px}
  .track{height:3px;width:100%;background:rgba(255,255,255,.10);overflow:hidden}
  .track > i{display:block;height:100%}
  .lstats{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:20px;
    padding:26px 0;margin:8px 0;border-top:1px solid var(--line-dark);border-bottom:1px solid var(--line-dark)}
  .lstats .st{display:flex;align-items:baseline;gap:10px}
  .lstats .st b{font-family:var(--mono);font-variant-numeric:tabular-nums;font-weight:700;
    font-size:26px;line-height:1;color:#fff}
  .lfoot{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;
    gap:8px 16px;margin-top:24px}

  /* ---------- Score breakdown (accordion) ---------- */
  .stack{border-top:1px solid var(--line)}
  .layer{border-bottom:1px solid var(--line);background:var(--paper-50)}
  .layer-head{display:grid;grid-template-columns:3px 1fr auto auto;align-items:center;gap:20px;
    padding:22px 20px;cursor:pointer;transition:background .15s}
  .layer-head:hover{background:rgba(20,20,15,.03)}
  .layer .spine{width:3px;align-self:stretch}
  .layer .title h3{font-weight:700;font-size:17px;letter-spacing:-.01em}
  .layer .title .desc{font-size:13.5px;color:var(--ink-500);margin-top:4px}
  .layer .save{font-family:var(--mono);font-variant-numeric:tabular-nums;font-weight:700;
    font-size:24px;white-space:nowrap}
  .layer .chev{width:22px;height:22px;border:1px solid var(--line);display:grid;place-items:center;
    color:var(--ink-400);font-size:11px;transition:transform .2s ease;flex-shrink:0}
  .layer.open .chev{transform:rotate(180deg)}
  .layer-body{max-height:0;overflow:hidden;transition:max-height .32s ease}
  .layer.open .layer-body{max-height:3000px;border-top:1px solid var(--line-soft)}
  .layer-body .inner{padding:22px 20px 24px 43px}
  .layer-body p{font-size:14px;color:var(--ink-700);margin:0 0 .7rem}
  .layer-body p:last-child{margin-bottom:0}
  .dim-table{width:100%;font-size:13px;margin-top:1rem;border-collapse:collapse}
  .dim-table th{font-family:var(--mono);font-size:11px;font-weight:500;letter-spacing:.16em;
    text-transform:uppercase;color:var(--ink-400);text-align:left;padding:.5rem .6rem;
    border-bottom:1px solid var(--line)}
  .dim-table td{padding:.6rem;border-bottom:1px solid var(--line-soft);text-align:left;vertical-align:top;
    color:var(--ink-700)}
  .dim-table td:nth-child(2),.dim-table td:nth-child(3){font-family:var(--mono);font-variant-numeric:tabular-nums}
  .tag-gap{color:var(--ochre-600)}
  .tag-strength{color:var(--mint-700)}

  /* ---------- Strengths / gaps / flags ---------- */
  .surfaces{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:0;
    border-top:1px solid var(--line);border-left:1px solid var(--line)}
  .surf{border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:26px 24px;
    background:var(--paper-50)}
  .surf h3{font-family:var(--mono);font-size:11px;font-weight:500;letter-spacing:.16em;
    text-transform:uppercase;color:var(--mint-700);margin-bottom:16px}
  .surf.gaps h3{color:var(--ochre-600)}
  .surf.flags h3{color:var(--rust-600)}
  .surf li{font-size:14.5px;color:var(--ink-700);padding-left:22px;position:relative;margin:10px 0;line-height:1.5}
  .surf li::before{content:"+";position:absolute;left:0;top:0;font-family:var(--mono);color:var(--mint-600)}
  .surf.gaps li::before{content:"\2192";color:var(--ochre)}
  .surf.flags li::before{content:"!";color:var(--rust)}
  .surf .empty{color:var(--ink-300);font-style:italic}
  .surf .empty::before{content:"\2014";color:var(--ink-300)}

  /* ---------- Rationale pull quote ---------- */
  .pq{border-top:1px solid var(--line);padding-top:32px}
  .pq .q{font-family:var(--serif);font-style:italic;font-size:clamp(22px,3.2vw,34px);
    line-height:1.35;letter-spacing:-.01em;max-width:34ch;color:var(--ink)}
  .pq .attr{margin-top:24px;font-family:var(--mono);font-size:11px;letter-spacing:.16em;
    text-transform:uppercase;color:var(--ink-400)}

  /* ---------- Roadmap ---------- */
  .road{border-top:1px solid var(--line)}
  .step{display:flex;gap:22px;padding:20px 4px;border-bottom:1px solid var(--line-soft);align-items:flex-start}
  .step .sn{font-family:var(--mono);font-size:11px;letter-spacing:.16em;color:var(--ink-300);
    padding-top:3px;flex:0 0 24px}
  .step p{font-size:15px;color:var(--ink-700);line-height:1.55}

  /* ---------- Interview notes ---------- */
  .notes-card{border-left:2px solid var(--ink);padding:4px 0 4px 24px}
  .notes-card p{font-size:15px;color:var(--ink-700);margin:0 0 .7rem}
  .notes-card p:last-child{margin-bottom:0}

  /* ---------- Footer ---------- */
  footer{background:var(--panel);color:rgba(255,255,255,.45);padding:48px 0}
  footer .ftop{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:20px}
  footer .wordmark .mark{background:var(--paper);color:var(--ink)}
  footer .wordmark .name{color:var(--paper)}
  footer .fnotes{font-family:var(--mono);font-size:11px;letter-spacing:.06em;
    color:rgba(255,255,255,.4);margin-top:28px;padding-top:24px;
    border-top:1px solid var(--line-dark);line-height:1.9}

  /* ---------- Export toolbar (screen only) ---------- */
  .export-toolbar{position:fixed;bottom:24px;right:24px;z-index:40;display:flex;gap:8px}
  .export-btn{display:inline-flex;align-items:center;gap:8px;background:var(--ink);color:var(--paper);
    border:none;padding:12px 20px;font-family:var(--sans);font-size:13px;font-weight:700;cursor:pointer}
  .export-btn:hover{background:var(--ink-700)}

  @media (max-width:680px){
    .wrap{padding:0 20px}
    .surfaces{grid-template-columns:1fr}
    .layer-head{grid-template-columns:3px 1fr auto;gap:14px}
    .layer .chev{display:none}
    .layer-body .inner{padding-left:20px}
    .verdict .status{text-align:left}
  }
  @media print{
    body{background:#fff}
    .ledger,footer{-webkit-print-color-adjust:exact;print-color-adjust:exact}
    .layer-body{max-height:none!important}
    .layer.open .layer-body,.layer-body{border-top:1px solid var(--line-soft)}
    .layer .chev,.export-toolbar{display:none}
    .layer-head{cursor:default}
    section{padding:28px 0;break-inside:avoid}
    .layer{break-inside:avoid}
  }
</style>
</head>
<body>
<div class="export-toolbar">
  <button class="export-btn" onclick="window.print()">{{ 'report.export_pdf' | t(language) }}</button>
</div>

{% set status_keys = {"GO": "report.status_go", "HOLD": "report.status_hold", "NO_GO": "report.status_no_go"} %}
{% set status_colors = {"GO": "#8ed4a4", "HOLD": "#c08a2e", "NO_GO": "#d2542a"} %}
{% macro tone(v) %}{{ '#57ab74' if v >= 75 else ('#c08a2e' if v >= 50 else '#d2542a') }}{% endmacro %}

<!-- MASTHEAD -->
<div class="masthead">
  <div class="wrap">
    <span class="wordmark"><span class="mark">R</span><span class="name">Recruitment&nbsp;Suite</span></span>
    <span class="eyebrow">{{ 'report.generated' | t(language) }}: {{ generated_at }}</span>
  </div>
</div>

<!-- HERO -->
<header class="hero">
  <div class="wrap">
    <span class="eyebrow rule-eyebrow">{{ 'report.title' | t(language) }}</span>
    <h1>{{ candidate_name }}</h1>
    <p class="role">{{ job_title }}{% if job_company %} — {{ job_company }}{% endif %}</p>
    <div class="hero-meta">
      <span class="chip">{{ 'report.confidence' | t(language) }} · {{ confidence }}%</span>
      <span class="chip">{{ status_keys[recommendation] | t(language) }}</span>
    </div>
  </div>
</header>

<!-- VERDICT LEDGER -->
<section style="border-bottom:none">
  <div class="wrap">
    <div class="ledger">
      <div class="ledger-head">
        <span class="panel-label">{{ 'report.title' | t(language) }}</span>
        <span class="panel-label">{{ candidate_name }}</span>
      </div>

      <div class="verdict">
        <div>
          <div class="panel-label" style="margin-bottom:10px">{{ 'report.final_score' | t(language) }}</div>
          <div class="fig">{{ final_score }}<span class="of">/100</span></div>
        </div>
        <div>
          <div class="panel-label" style="margin-bottom:10px">{{ 'report.recommendation' | t(language) }}</div>
          <div class="status" style="color:{{ status_colors[recommendation] }}">{{ status_keys[recommendation] | t(language) }}</div>
        </div>
      </div>

      {% if pre_interview_score is not none %}
      <div class="lrow">
        <div class="top">
          <span class="panel-label">{{ 'report.score_before_notes' | t(language) }}{% if pre_interview_status %} · {{ status_keys[pre_interview_status] | t(language) }}{% endif %}</span>
          <span class="val" style="color:#c08a2e">{{ pre_interview_score }}</span>
        </div>
        <div class="track"><i style="width:{{ pre_interview_score }}%;background:#c08a2e"></i></div>
      </div>
      <div class="lrow">
        <div class="top">
          <span class="panel-label">{{ 'report.score_after_notes' | t(language) }}</span>
          <span class="val" style="color:#8ed4a4">{{ final_score }}</span>
        </div>
        <div class="track"><i style="width:{{ final_score }}%;background:#8ed4a4"></i></div>
      </div>
      {% else %}
      <div class="lrow">
        <div class="top">
          <span class="panel-label">{{ 'report.final_score' | t(language) }}</span>
          <span class="val" style="color:{{ status_colors[recommendation] }}">{{ final_score }}</span>
        </div>
        <div class="track"><i style="width:{{ final_score }}%;background:{{ status_colors[recommendation] }}"></i></div>
      </div>
      {% endif %}

      <div class="lstats">
        <div class="st"><b>{{ confidence }}%</b><span class="panel-label">{{ 'report.confidence' | t(language) }}</span></div>
        <div class="st"><b>+{{ strategic_bonus }}</b><span class="panel-label">{{ 'report.strategic_bonus' | t(language) }}</span></div>
      </div>

      <div class="lfoot">
        <span class="panel-label">{{ 'report.strategic_bonus_tip' | t(language) }}</span>
      </div>
    </div>
  </div>
</section>

{% set dim_keys = {
  "Profile": "dimension.profile",
  "Technical": "dimension.technical",
  "Culture Fit": "dimension.culture_fit",
  "References": "dimension.references",
} %}
{% set dim_tips = {
  "Profile": "report.profile_tip",
  "Technical": "report.technical_tip",
  "Culture Fit": "report.culture_fit_tip",
  "References": "report.references_tip",
} %}

<!-- SCORE BREAKDOWN (accordion layers) -->
<section>
  <div class="wrap">
    <span class="eyebrow rule-eyebrow">01</span>
    <h2 class="h">{{ 'report.score_breakdown' | t(language) }}</h2>
    <div class="section-intro">{{ 'report.score_breakdown_tip' | t(language) }}</div>

    <div class="stack">
      {% for label, value in [
        ("Profile", profile_score),
        ("Technical", technical_score),
        ("Culture Fit", culture_score),
        ("References", reference_score),
      ] %}
      {% if label != "Technical" or people_analytics_score is none %}
      <article class="layer">
        <div class="layer-head" onclick="this.closest('.layer').classList.toggle('open')">
          <div class="spine" style="background:{{ tone(value) }}"></div>
          <div class="title">
            <h3>{{ dim_keys[label] | t(language) }}</h3>
            <div class="desc">{{ dim_tips[label] | t(language) }}</div>
          </div>
          <div class="save" style="color:{{ tone(value) }}">{{ value }}</div>
          <div class="chev">▾</div>
        </div>
        {% if agent_analysis.get(label) %}
        <div class="layer-body"><div class="inner">
          {{ agent_analysis[label].analysis | analysis_html }}
          {% if agent_analysis[label].dimensions %}
          <table class="dim-table">
            <tr><th>{{ 'report.dimension_col' | t(language) }}</th><th>{{ 'report.score_col' | t(language) }}</th><th>{{ 'report.weight_col' | t(language) }}</th><th>{{ 'report.notes_col' | t(language) }}</th></tr>
            {% for d in agent_analysis[label].dimensions %}
            <tr>
              <td>{{ d.dimension }}</td>
              <td>{{ d.score }}</td>
              <td>{{ (d.weight * 100) | round | int }}%</td>
              <td>
                {% for s in d.strengths %}<span class="tag-strength">+ {{ s }}</span><br>{% endfor %}
                {% for g in d.gaps %}<span class="tag-gap">→ {{ g }}</span><br>{% endfor %}
              </td>
            </tr>
            {% endfor %}
          </table>
          {% endif %}
        </div></div>
        {% endif %}
      </article>
      {% endif %}
      {% endfor %}

      {% if people_analytics_score is not none %}
      <article class="layer">
        <div class="layer-head" onclick="this.closest('.layer').classList.toggle('open')">
          <div class="spine" style="background:{{ tone(people_analytics_score) }}"></div>
          <div class="title">
            <h3>{{ 'dimension.people_analytics' | t(language) }}</h3>
            <div class="desc">{{ 'report.people_analytics_tip' | t(language) }}</div>
          </div>
          <div class="save" style="color:{{ tone(people_analytics_score) }}">{{ people_analytics_score }}</div>
          <div class="chev">▾</div>
        </div>
        {% if agent_analysis.get("People Analytics") %}
        <div class="layer-body"><div class="inner">
          {{ agent_analysis["People Analytics"].analysis | analysis_html }}
          {% if agent_analysis["People Analytics"].dimensions %}
          <table class="dim-table">
            <tr><th>{{ 'report.dimension_col' | t(language) }}</th><th>{{ 'report.score_col' | t(language) }}</th><th>{{ 'report.weight_col' | t(language) }}</th><th>{{ 'report.notes_col' | t(language) }}</th></tr>
            {% for d in agent_analysis["People Analytics"].dimensions %}
            <tr>
              <td>{{ d.dimension }}</td>
              <td>{{ d.score }}</td>
              <td>{{ (d.weight * 100) | round | int }}%</td>
              <td>
                {% for s in d.strengths %}<span class="tag-strength">+ {{ s }}</span><br>{% endfor %}
                {% for g in d.gaps %}<span class="tag-gap">→ {{ g }}</span><br>{% endfor %}
              </td>
            </tr>
            {% endfor %}
          </table>
          {% endif %}
        </div></div>
        {% endif %}
      </article>
      {% endif %}
    </div>
  </div>
</section>

<!-- STRENGTHS / GAPS / FLAGS -->
<section>
  <div class="wrap">
    <span class="eyebrow rule-eyebrow">02</span>
    <h2 class="h">{{ 'report.key_strengths' | t(language) }} · {{ 'report.addressable_gaps' | t(language) }}</h2>
    <div class="section-intro">{{ 'report.key_strengths_tip' | t(language) }}</div>

    <div class="surfaces">
      <div class="surf">
        <h3>{{ 'report.key_strengths' | t(language) }}</h3>
        <ul>
          {% for s in strengths %}<li>{{ s }}</li>{% else %}<li class="empty">{{ 'report.none_identified' | t(language) }}</li>{% endfor %}
        </ul>
      </div>
      <div class="surf gaps">
        <h3>{{ 'report.addressable_gaps' | t(language) }}</h3>
        <ul>
          {% for g in gaps %}<li>{{ g }}</li>{% else %}<li class="empty">{{ 'report.none_identified' | t(language) }}</li>{% endfor %}
        </ul>
      </div>
      {% if flags %}
      <div class="surf flags">
        <h3>{{ 'report.critical_flags' | t(language) }}</h3>
        <ul>
          {% for f in flags %}<li>{{ f }}</li>{% endfor %}
        </ul>
      </div>
      {% endif %}
    </div>
  </div>
</section>

<!-- RATIONALE PULL QUOTE -->
<section>
  <div class="wrap">
    <div class="pq">
      <div class="q">{{ rationale }}</div>
      <div class="attr">{{ status_keys[recommendation] | t(language) }} · {{ 'report.confidence' | t(language) }} {{ confidence }}%</div>
    </div>
  </div>
</section>

<!-- ROADMAP (next steps + onboarding) -->
<section>
  <div class="wrap">
    <span class="eyebrow rule-eyebrow">03</span>
    <h2 class="h">{{ 'report.next_steps' | t(language) }}</h2>
    <div class="road">
      {% for step in next_steps %}
      <div class="step"><div class="sn">{{ '%02d' % loop.index }}</div><p>{{ step }}</p></div>
      {% endfor %}
      {% if onboarding %}
        {% for item in onboarding %}
        <div class="step"><div class="sn">{{ '%02d' % (next_steps|length + loop.index) }}</div><p>{{ item }}</p></div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% if interview_notes %}
<section>
  <div class="wrap">
    <span class="eyebrow rule-eyebrow">04</span>
    <h2 class="h">{{ 'report.interview_notes' | t(language) }}</h2>
    <div class="section-intro">{{ 'report.interview_notes_tip' | t(language) }}</div>
    <div class="notes-card">
      {{ interview_notes | analysis_html }}
      {% if notes_updated_at %}<p class="eyebrow" style="margin-top:16px">{{ 'report.generated' | t(language) }}: {{ notes_updated_at }}</p>{% endif %}
    </div>
  </div>
</section>
{% endif %}

<!-- FOOTER -->
<footer>
  <div class="wrap">
    <div class="ftop">
      <span class="wordmark"><span class="mark">R</span><span class="name">Recruitment&nbsp;Suite</span></span>
      <span class="panel-label">{{ 'report.title' | t(language) }}</span>
    </div>
    <div class="fnotes">
      {{ 'report.candidate' | t(language) }}: {{ candidate_name }}<br>
      {{ 'report.job' | t(language) }}: {{ job_title }}{% if job_company %} {{ 'report.at' | t(language) }} {{ job_company }}{% endif %}<br>
      {{ 'report.generated' | t(language) }}: {{ generated_at }}
    </div>
  </div>
</footer>

</body>
</html>
