<!DOCTYPE html>
<html lang="{{ language[:2] }}">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{{ 'report.title' | t(language) }} — {{ candidate_name }}</title>
<!-- Inlined as base64 (matches frontend/public/favicon.svg) so the icon shows
     both on the live report URL and when the "Download HTML" button saves
     this page standalone — a relative /favicon.svg path only resolves when
     served from the app's own origin. -->
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64," />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  /* ==================================================================
     Ledger. Warm paper, hairline squares, five colours with one job each:
     orange = cost / risk, mint = proof / pass, lime = live (unused here),
     ink speaks. Status is shape + word + tint, never colour alone.
     The dark panel is fixed dark in both themes.
     ================================================================== */
  :root{
    --paper:#F1EEE5; --paper-2:#E8E4D7; --ink:#17140F; --ink-soft:#5A5446; --line:#CFC9B8;
    --orange:#C9591F; --orange-ink:#A8460F; --mint:#4E9E78; --mint-ink:#2F7454;
    --panel:#100E0B; --panel-2:#1A1713; --panel-line:#38332B; --panel-text:#EDE9DE; --panel-text-soft:#A8A294;
    /* Hues on the dark panel use the dark-theme values so they hold contrast. */
    --p-orange:#E07A3C; --p-mint:#7EC8A1;
    --sans:'Archivo',Arial,Helvetica,sans-serif;
    --mono:'IBM Plex Mono',Menlo,Consolas,monospace;
  }
  @media screen and (prefers-color-scheme:dark){
    :root{
      --paper:#151310; --paper-2:#1D1A16; --ink:#EDE9DE; --ink-soft:#A8A294; --line:#332E27;
      --orange:#E07A3C; --orange-ink:#E07A3C; --mint:#7EC8A1; --mint-ink:#7EC8A1;
    }
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
  body{font-family:var(--sans);color:var(--ink);background:var(--paper);line-height:1.6;
    -webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}
  :focus-visible{outline:2px solid var(--orange);outline-offset:3px}
  .wrap{max-width:1000px;margin:0 auto;padding:0 32px}
  ul{list-style:none}
  b,strong{font-weight:600}

  /* ---------- Shared type ---------- */
  .eyebrow{font-family:var(--mono);font-size:11px;font-weight:500;letter-spacing:.16em;
    text-transform:uppercase;color:var(--ink-soft)}
  .rule-eyebrow{display:inline-flex;align-items:center;gap:12px}
  .rule-eyebrow::before{content:"";display:block;width:34px;height:1px;background:currentColor}
  .mono{font-family:var(--mono);font-variant-numeric:tabular-nums}
  .chip{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--ink);
    padding:6px 12px;font-family:var(--mono);font-size:11px;letter-spacing:.16em;
    text-transform:uppercase;color:var(--ink)}

  section{padding:56px 0;border-bottom:1px solid var(--line)}
  h2.h{font-size:clamp(24px,3vw,32px);font-weight:800;letter-spacing:-.02em;line-height:1.05;margin:16px 0 12px}
  .section-intro{font-size:15px;color:var(--ink-soft);max-width:62ch;margin-bottom:32px}

  /* ---------- Masthead ---------- */
  .masthead{border-bottom:1px solid var(--line);padding:28px 0}
  .masthead .wrap{display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}
  .wordmark{display:inline-flex;align-items:center;gap:10px}
  .wordmark .mark{width:26px;height:26px;background:var(--ink);color:var(--paper);
    display:grid;place-items:center;font-weight:800;font-size:16px;line-height:1}
  .wordmark .name{font-weight:800;text-transform:uppercase;letter-spacing:.14em;font-size:14px}

  /* ---------- Hero ---------- */
  .hero{padding:64px 0 56px;border-bottom:1px solid var(--line)}
  .hero h1{font-size:clamp(38px,6vw,64px);font-weight:800;letter-spacing:-.03em;line-height:1.0;margin:24px 0 12px}
  .hero .role{font-weight:600;font-size:clamp(18px,2.2vw,22px);color:var(--ink-soft);letter-spacing:-.01em}
  .hero-meta{margin-top:28px;display:flex;flex-wrap:wrap;gap:10px}

  /* ---------- Verdict: Proof Panel ---------- */
  .ledger{background:var(--panel);color:var(--panel-text);border:1px solid var(--panel-line);padding:32px}
  .ledger-head{display:flex;align-items:center;justify-content:space-between;gap:16px;
    flex-wrap:wrap;margin-bottom:28px}
  .panel-label{font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;
    color:var(--panel-text-soft)}
  .verdict{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap;margin-bottom:28px}
  .verdict .fig{font-family:var(--mono);font-variant-numeric:tabular-nums;font-weight:600;
    font-size:64px;line-height:.9;letter-spacing:-.03em;color:var(--panel-text)}
  .verdict .fig .of{font-size:20px;color:var(--panel-text-soft)}
  .verdict .status{font-family:var(--mono);font-weight:600;font-size:30px;letter-spacing:-.01em;text-align:right;
    display:inline-flex;align-items:center;gap:12px;color:var(--panel-text)}
  .flag{display:inline-grid;place-items:center;width:28px;height:28px;font-size:15px;line-height:1;
    color:#0C0A08;font-family:var(--mono);font-weight:600}
  .st-go .flag{background:var(--p-mint)}
  .st-no_go .flag{background:var(--p-orange)}
  .st-hold .flag{background:var(--panel-text)}
  .lrow{margin-bottom:20px}
  .lrow:last-child{margin-bottom:0}
  .lrow .top{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:10px}
  .lrow .val{font-family:var(--mono);font-variant-numeric:tabular-nums;font-weight:600;font-size:22px}
  .track{height:3px;width:100%;background:var(--panel-line);overflow:hidden}
  .track > i{display:block;height:100%}
  .bar-orange{background:var(--p-orange)} .txt-orange{color:var(--p-orange)}
  .bar-mint{background:var(--p-mint)}     .txt-mint{color:var(--p-mint)}
  .bar-plain{background:var(--panel-text)} .txt-plain{color:var(--panel-text)}
  .lstats{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:20px;
    padding:26px 0;margin:8px 0;border-top:1px solid var(--panel-line);border-bottom:1px solid var(--panel-line)}
  .lstats .st{display:flex;align-items:baseline;gap:10px}
  .lstats .st b{font-family:var(--mono);font-variant-numeric:tabular-nums;font-weight:600;
    font-size:26px;line-height:1;color:var(--panel-text)}
  .lfoot{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;
    gap:8px 16px;margin-top:24px}

  /* ---------- Score breakdown (accordion) ---------- */
  .stack{border-top:1px solid var(--ink)}
  .layer{border-bottom:1px solid var(--line)}
  .layer-head{display:grid;grid-template-columns:3px 1fr auto auto;align-items:center;gap:20px;
    padding:22px 20px;cursor:pointer;min-height:44px}
  .layer-head:hover{background:var(--paper-2)}
  .layer .spine{width:3px;align-self:stretch}
  .layer .title h3{font-weight:600;font-size:17px;letter-spacing:-.01em}
  .layer .title .desc{font-size:13.5px;color:var(--ink-soft);margin-top:4px}
  .layer .save{font-family:var(--mono);font-variant-numeric:tabular-nums;font-weight:600;
    font-size:24px;white-space:nowrap;color:var(--ink)}
  .tone-mint .spine{background:var(--mint)}
  .tone-ink .spine{background:var(--ink)}
  .tone-orange .spine{background:var(--orange)}
  .layer .chev{width:22px;height:22px;border:1px solid var(--line);display:grid;place-items:center;
    color:var(--ink-soft);font-size:11px;flex-shrink:0}
  .layer.open .chev{transform:rotate(180deg)}
  @media (prefers-reduced-motion:no-preference){.layer .chev{transition:transform .2s ease}
    .layer-head{transition:background .15s}.layer-body{transition:max-height .32s ease}}
  .layer-body{max-height:0;overflow:hidden}
  .layer.open .layer-body{max-height:3000px;border-top:1px solid var(--line)}
  .layer-body .inner{padding:22px 20px 24px 43px}
  .layer-body p{font-size:14px;color:var(--ink);margin:0 0 .7rem}
  .layer-body p:last-child{margin-bottom:0}
  .dim-table{width:100%;font-size:13px;margin-top:1rem;border-collapse:collapse}
  .dim-table th{font-family:var(--mono);font-size:11px;font-weight:500;letter-spacing:.16em;
    text-transform:uppercase;color:var(--ink-soft);text-align:left;padding:.5rem .6rem;
    border-bottom:1px solid var(--ink);background:var(--paper-2)}
  .dim-table td{padding:.6rem;border-bottom:1px solid var(--line);text-align:left;vertical-align:top;color:var(--ink)}
  .dim-table td:nth-child(2),.dim-table td:nth-child(3){font-family:var(--mono);font-variant-numeric:tabular-nums}
  .tag-gap{color:var(--ink)}
  .tag-strength{color:var(--mint-ink)}


  /* ---------- Eligibility (Agent 07) ---------- */
  .elig{border-top:1px solid var(--ink)}
  .erow{display:grid;grid-template-columns:28px 1fr auto;gap:16px;align-items:start;
    padding:16px 4px;border-bottom:1px solid var(--line)}
  .eflag{display:inline-grid;place-items:center;width:22px;height:22px;font-family:var(--mono);
    font-size:12px;font-weight:600;color:#0C0A08}
  .st-met .eflag{background:var(--mint)}
  .st-confirm .eflag{background:transparent;color:var(--ink);border:1px solid var(--ink)}
  .ereq{font-size:15px;color:var(--ink);line-height:1.5}
  .eev{font-family:var(--mono);font-size:12px;color:var(--ink-soft);margin-top:4px}
  .estat{font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;
    color:var(--ink);border:1px solid var(--line);padding:3px 8px;white-space:nowrap}

  /* ---------- Strengths / gaps / flags ---------- */
  .surfaces{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1px;
    background:var(--ink);border:1px solid var(--ink)}
  .surf{padding:26px 24px;background:var(--paper)}
  .surf h3{font-family:var(--mono);font-size:11px;font-weight:500;letter-spacing:.16em;
    text-transform:uppercase;color:var(--ink);margin-bottom:16px}
  .surf li{font-size:14.5px;color:var(--ink);padding-left:22px;position:relative;margin:10px 0;line-height:1.5}
  .surf li::before{content:"\2713";position:absolute;left:0;top:0;font-family:var(--mono);color:var(--mint-ink)}
  .surf.gaps li::before{content:"\2192";color:var(--ink)}
  .surf.flags li::before{content:"\2715";color:var(--orange-ink)}
  .surf .empty{color:var(--ink-soft)}
  .surf .empty::before{content:"\2014";color:var(--ink-soft)}

  /* ---------- Rationale ---------- */
  .pq{border-top:1px solid var(--line);padding-top:32px}
  .pq .q{font-weight:600;font-size:clamp(20px,2.6vw,26px);line-height:1.4;letter-spacing:-.01em;
    max-width:44ch;color:var(--ink);border-left:2px solid var(--ink);padding-left:20px}
  .pq .attr{margin-top:20px;padding-left:22px;font-family:var(--mono);font-size:11px;letter-spacing:.16em;
    text-transform:uppercase;color:var(--ink-soft)}

  /* ---------- Roadmap ---------- */
  .road{border-top:1px solid var(--ink)}
  .step{display:flex;gap:22px;padding:20px 4px;border-bottom:1px solid var(--line);align-items:flex-start}
  .step .sn{font-family:var(--mono);font-size:11px;letter-spacing:.16em;color:var(--ink-soft);
    padding-top:3px;flex:0 0 24px}
  .step p{font-size:15px;color:var(--ink);line-height:1.55}

  /* ---------- Interview guide ---------- */
  .guide{border-top:1px solid var(--ink)}
  .gq{padding:22px 4px;border-bottom:1px solid var(--line);display:grid;
    grid-template-columns:26px 1fr;gap:0 22px}
  .gq .gqn{font-family:var(--mono);font-size:11px;letter-spacing:.16em;color:var(--ink-soft);padding-top:3px}
  .gq .gqhead{display:flex;flex-wrap:wrap;align-items:baseline;gap:10px;margin-bottom:8px}
  .gq .gqfocus{font-family:var(--mono);font-size:11px;font-weight:500;letter-spacing:.16em;
    text-transform:uppercase;color:var(--ink)}
  .gq .gqdim{font-family:var(--mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;
    color:var(--ink-soft);border:1px solid var(--line);padding:2px 8px}
  .gq .gqtext{font-size:15.5px;color:var(--ink);line-height:1.55}
  .gq .gqlisten{margin-top:10px;padding-left:14px;border-left:2px solid var(--mint);
    font-size:14px;color:var(--ink-soft);line-height:1.5}
  .gq .gqlisten b{font-family:var(--mono);font-size:10px;font-weight:500;letter-spacing:.16em;
    text-transform:uppercase;color:var(--mint-ink);display:block;margin-bottom:3px}

  /* ---------- Interview notes ---------- */
  .notes-card{border-left:2px solid var(--ink);padding:4px 0 4px 24px}
  .notes-card p{font-size:15px;color:var(--ink);margin:0 0 .7rem}
  .notes-card p:last-child{margin-bottom:0}

  /* ---------- Footer ---------- */
  footer{background:var(--panel);color:var(--panel-text-soft);padding:48px 0}
  footer .ftop{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:20px}
  footer .wordmark .mark{background:var(--panel-text);color:var(--panel)}
  footer .wordmark .name{color:var(--panel-text)}
  footer .fnotes{font-family:var(--mono);font-size:11px;letter-spacing:.06em;
    color:var(--panel-text-soft);margin-top:28px;padding-top:24px;
    border-top:1px solid var(--panel-line);line-height:1.9}

  /* ---------- Export toolbar (screen only) ---------- */
  .export-toolbar{position:fixed;bottom:24px;right:24px;z-index:40;display:flex;gap:8px}
  .export-btn{display:inline-flex;align-items:center;gap:8px;background:var(--ink);color:var(--paper);
    border:none;min-height:44px;padding:0 20px;font-family:var(--sans);font-size:13px;font-weight:600;cursor:pointer}
  .export-btn:hover{background:var(--orange-ink);color:#F1EEE5}
  @media (prefers-reduced-motion:no-preference){.export-btn{transition:background .15s,transform .15s}
    .export-btn:hover{transform:translateY(-1px)}}

  @media (max-width:680px){
    .wrap{padding:0 16px}
    .surfaces{grid-template-columns:1fr}
    .layer-head{grid-template-columns:3px 1fr auto;gap:14px}
    .layer .chev{display:none}
    .layer-body .inner{padding-left:20px}
    .verdict .status{text-align:left}
  }
  @media print{
    body{background:#fff}
    .ledger,footer,.flag,.track > i{-webkit-print-color-adjust:exact;print-color-adjust:exact}
    .layer-body{max-height:none!important}
    .layer.open .layer-body,.layer-body{border-top:1px solid var(--line)}
    .layer .chev,.export-toolbar{display:none}
    .layer-head{cursor:default}
    section{padding:28px 0;break-inside:avoid}
    .layer{break-inside:avoid}
  }
</style>
</head>
<body>
<div class="export-toolbar">
  <button class="export-btn" onclick="window.print()">{{ 'report.export_pdf' | t(language) }}</button>
</div>

{% set status_keys = {"GO": "report.status_go", "HOLD": "report.status_hold", "NO_GO": "report.status_no_go"} %}
{% set status_tone = {"GO": "mint", "HOLD": "plain", "NO_GO": "orange"} %}
{% set status_glyph = {"GO": "\u2713", "HOLD": "\u25B2", "NO_GO": "\u2715"} %}
{% macro tone(v) %}{{ 'mint' if v >= 75 else ('ink' if v >= 50 else 'orange') }}{% endmacro %}

<!-- MASTHEAD -->
<div class="masthead">
  <div class="wrap">
    <span class="wordmark"><span class="mark">R</span><span class="name">Recruitment&nbsp;Suite</span></span>
    <span class="eyebrow">{{ 'report.generated' | t(language) }}: {{ generated_at }}</span>
  </div>
</div>

<!-- HERO -->
<header class="hero">
  <div class="wrap">
    <span class="eyebrow rule-eyebrow">{{ 'report.title' | t(language) }}</span>
    <h1>{{ candidate_name }}</h1>
    <p class="role">{{ job_title }}{% if job_company %} — {{ job_company }}{% endif %}</p>
    <div class="hero-meta">
      <span class="chip">{{ 'report.confidence' | t(language) }} · {{ confidence }}%</span>
      <span class="chip">{{ status_keys[recommendation] | t(language) }}</span>
    </div>
  </div>
</header>

<!-- VERDICT LEDGER -->
<section style="border-bottom:none">
  <div class="wrap">
    <div class="ledger">
      <div class="ledger-head">
        <span class="panel-label">{{ 'report.title' | t(language) }}</span>
        <span class="panel-label">{{ candidate_name }}</span>
      </div>

      <div class="verdict">
        <div>
          <div class="panel-label" style="margin-bottom:10px">{{ 'report.final_score' | t(language) }}</div>
          <div class="fig">{{ final_score }}<span class="of">/100</span></div>
        </div>
        <div>
          <div class="panel-label" style="margin-bottom:10px">{{ 'report.recommendation' | t(language) }}</div>
          <div class="status st-{{ recommendation | lower }}"><span class="flag" aria-hidden="true">{{ status_glyph[recommendation] }}</span>{{ status_keys[recommendation] | t(language) }}</div>
        </div>
      </div>

      {% if pre_interview_score is not none %}
      <div class="lrow">
        <div class="top">
          <span class="panel-label">{{ 'report.score_before_notes' | t(language) }}{% if pre_interview_status %} · {{ status_keys[pre_interview_status] | t(language) }}{% endif %}</span>
          <span class="val txt-orange">{{ pre_interview_score }}</span>
        </div>
        <div class="track"><i class="bar-orange" style="width:{{ pre_interview_score }}%"></i></div>
      </div>
      <div class="lrow">
        <div class="top">
          <span class="panel-label">{{ 'report.score_after_notes' | t(language) }}</span>
          <span class="val txt-mint">{{ final_score }}</span>
        </div>
        <div class="track"><i class="bar-mint" style="width:{{ final_score }}%"></i></div>
      </div>
      {% else %}
      <div class="lrow">
        <div class="top">
          <span class="panel-label">{{ 'report.final_score' | t(language) }}</span>
          <span class="val txt-{{ status_tone[recommendation] }}">{{ final_score }}</span>
        </div>
        <div class="track"><i class="bar-{{ status_tone[recommendation] }}" style="width:{{ final_score }}%"></i></div>
      </div>
      {% endif %}

      <div class="lstats">
        <div class="st"><b>{{ confidence }}%</b><span class="panel-label">{{ 'report.confidence' | t(language) }}</span></div>
        <div class="st"><b>+{{ strategic_bonus }}</b><span class="panel-label">{{ 'report.strategic_bonus' | t(language) }}</span></div>
      </div>

      <div class="lfoot">
        <span class="panel-label">{{ 'report.strategic_bonus_tip' | t(language) }}</span>
      </div>
    </div>
  </div>
</section>

{% set dim_keys = {
  "Profile": "dimension.profile",
  "Technical": "dimension.technical",
  "Culture Fit": "dimension.culture_fit",
  "References": "dimension.references",
} %}
{% set dim_tips = {
  "Profile": "report.profile_tip",
  "Technical": "report.technical_tip",
  "Culture Fit": "report.culture_fit_tip",
  "References": "report.references_tip",
} %}

<!-- SCORE BREAKDOWN (accordion layers) -->
<section>
  <div class="wrap">
    <span class="eyebrow rule-eyebrow">01</span>
    <h2 class="h">{{ 'report.score_breakdown' | t(language) }}</h2>
    <div class="section-intro">{{ 'report.score_breakdown_tip' | t(language) }}</div>

    <div class="stack">
      {% for label, value in [
        ("Profile", profile_score),
        ("Technical", technical_score),
        ("Culture Fit", culture_score),
        ("References", reference_score),
      ] %}
      {% if label != "Technical" or people_analytics_score is none %}
      <article class="layer tone-{{ tone(value) }}">
        <div class="layer-head" role="button" tabindex="0" aria-expanded="false" onclick="toggleLayer(this)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleLayer(this)}">
          <div class="spine"></div>
          <div class="title">
            <h3>{{ dim_keys[label] | t(language) }}</h3>
            <div class="desc">{{ dim_tips[label] | t(language) }}</div>
          </div>
          <div class="save">{{ value }}</div>
          <div class="chev">▾</div>
        </div>
        {% if agent_analysis.get(label) %}
        <div class="layer-body"><div class="inner">
          {{ agent_analysis[label].analysis | analysis_html }}
          {% if agent_analysis[label].dimensions %}
          <table class="dim-table">
            <tr><th>{{ 'report.dimension_col' | t(language) }}</th><th>{{ 'report.score_col' | t(language) }}</th><th>{{ 'report.weight_col' | t(language) }}</th><th>{{ 'report.notes_col' | t(language) }}</th></tr>
            {% for d in agent_analysis[label].dimensions %}
            <tr>
              <td>{{ d.dimension }}</td>
              <td>{{ d.score }}</td>
              <td>{{ (d.weight * 100) | round | int }}%</td>
              <td>
                {% for s in d.strengths %}<span class="tag-strength">+ {{ s }}</span><br>{% endfor %}
                {% for g in d.gaps %}<span class="tag-gap">→ {{ g }}</span><br>{% endfor %}
              </td>
            </tr>
            {% endfor %}
          </table>
          {% endif %}
        </div></div>
        {% endif %}
      </article>
      {% endif %}
      {% endfor %}

      {% if people_analytics_score is not none %}
      <article class="layer tone-{{ tone(people_analytics_score) }}">
        <div class="layer-head" role="button" tabindex="0" aria-expanded="false" onclick="toggleLayer(this)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleLayer(this)}">
          <div class="spine"></div>
          <div class="title">
            <h3>{{ 'dimension.people_analytics' | t(language) }}</h3>
            <div class="desc">{{ 'report.people_analytics_tip' | t(language) }}</div>
          </div>
          <div class="save">{{ people_analytics_score }}</div>
          <div class="chev">▾</div>
        </div>
        {% if agent_analysis.get("People Analytics") %}
        <div class="layer-body"><div class="inner">
          {{ agent_analysis["People Analytics"].analysis | analysis_html }}
          {% if agent_analysis["People Analytics"].dimensions %}
          <table class="dim-table">
            <tr><th>{{ 'report.dimension_col' | t(language) }}</th><th>{{ 'report.score_col' | t(language) }}</th><th>{{ 'report.weight_col' | t(language) }}</th><th>{{ 'report.notes_col' | t(language) }}</th></tr>
            {% for d in agent_analysis["People Analytics"].dimensions %}
            <tr>
              <td>{{ d.dimension }}</td>
              <td>{{ d.score }}</td>
              <td>{{ (d.weight * 100) | round | int }}%</td>
              <td>
                {% for s in d.strengths %}<span class="tag-strength">+ {{ s }}</span><br>{% endfor %}
                {% for g in d.gaps %}<span class="tag-gap">→ {{ g }}</span><br>{% endfor %}
              </td>
            </tr>
            {% endfor %}
          </table>
          {% endif %}
        </div></div>
        {% endif %}
      </article>
      {% endif %}
    </div>
  </div>
</section>

{% if eligibility_checks %}
<!-- ELIGIBILITY (Agent 07: hard constraints, not scored) -->
<section>
  <div class="wrap">
    <span class="eyebrow rule-eyebrow">02</span>
    <h2 class="h">{{ 'report.eligibility' | t(language) }}</h2>
    <div class="section-intro">{{ 'report.eligibility_tip' | t(language) }}</div>
    <div class="elig">
      {% for c in eligibility_checks %}
      <div class="erow st-{{ c.status }}">
        <span class="eflag" aria-hidden="true">{{ '✓' if c.status == 'met' else '▲' }}</span>
        <div>
          <p class="ereq">{{ c.requirement }}</p>
          {% if c.evidence %}<p class="eev">{{ c.evidence }}</p>{% endif %}
        </div>
        <span class="estat">{{ ('report.eligibility_met' if c.status == 'met' else 'report.eligibility_confirm') | t(language) }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
{% set n = 1 if eligibility_checks else 0 %}

<!-- STRENGTHS / GAPS / FLAGS -->
<section>
  <div class="wrap">
    <span class="eyebrow rule-eyebrow">{{ '%02d' % (2 + n) }}</span>
    <h2 class="h">{{ 'report.key_strengths' | t(language) }} · {{ 'report.addressable_gaps' | t(language) }}</h2>
    <div class="section-intro">{{ 'report.key_strengths_tip' | t(language) }}</div>

    <div class="surfaces">
      <div class="surf">
        <h3>{{ 'report.key_strengths' | t(language) }}</h3>
        <ul>
          {% for s in strengths %}<li>{{ s }}</li>{% else %}<li class="empty">{{ 'report.none_identified' | t(language) }}</li>{% endfor %}
        </ul>
      </div>
      <div class="surf gaps">
        <h3>{{ 'report.addressable_gaps' | t(language) }}</h3>
        <ul>
          {% for g in gaps %}<li>{{ g }}</li>{% else %}<li class="empty">{{ 'report.none_identified' | t(language) }}</li>{% endfor %}
        </ul>
      </div>
      {% if flags %}
      <div class="surf flags">
        <h3>{{ 'report.critical_flags' | t(language) }}</h3>
        <ul>
          {% for f in flags %}<li>{{ f }}</li>{% endfor %}
        </ul>
      </div>
      {% endif %}
    </div>
  </div>
</section>

<!-- RATIONALE PULL QUOTE -->
<section>
  <div class="wrap">
    <div class="pq">
      <div class="q">{{ rationale }}</div>
      <div class="attr">{{ status_keys[recommendation] | t(language) }} · {{ 'report.confidence' | t(language) }} {{ confidence }}%</div>
    </div>
  </div>
</section>

<!-- ROADMAP (next steps + onboarding) -->
<section>
  <div class="wrap">
    <span class="eyebrow rule-eyebrow">{{ '%02d' % (3 + n) }}</span>
    <h2 class="h">{{ 'report.next_steps' | t(language) }}</h2>
    <div class="road">
      {% for step in next_steps %}
      <div class="step"><div class="sn">{{ '%02d' % loop.index }}</div><p>{{ step }}</p></div>
      {% endfor %}
      {% if onboarding %}
        {% for item in onboarding %}
        <div class="step"><div class="sn">{{ '%02d' % (next_steps|length + loop.index) }}</div><p>{{ item }}</p></div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% if interview_guide %}
<section>
  <div class="wrap">
    <span class="eyebrow rule-eyebrow">{{ '%02d' % (4 + n) }}</span>
    <h2 class="h">{{ 'interview.title' | t(language) }}</h2>
    <div class="section-intro">{{ 'interview.tip' | t(language) }}</div>
    <div class="guide">
      {% for q in interview_guide %}
      <div class="gq">
        <div class="gqn">{{ '%02d' % loop.index }}</div>
        <div>
          <div class="gqhead">
            <span class="gqfocus">{{ q.focus }}</span>
            {% if q.dimension %}<span class="gqdim">{{ q.dimension }}</span>{% endif %}
          </div>
          <p class="gqtext">{{ q.question }}</p>
          <div class="gqlisten">
            <b>{{ 'interview.listen_col' | t(language) }}</b>
            {{ q.listen_for }}
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if interview_notes %}
<section>
  <div class="wrap">
    <span class="eyebrow rule-eyebrow">{{ '%02d' % (5 + n) }}</span>
    <h2 class="h">{{ 'report.interview_notes' | t(language) }}</h2>
    <div class="section-intro">{{ 'report.interview_notes_tip' | t(language) }}</div>
    <div class="notes-card">
      {{ interview_notes | analysis_html }}
      {% if notes_updated_at %}<p class="eyebrow" style="margin-top:16px">{{ 'report.generated' | t(language) }}: {{ notes_updated_at }}</p>{% endif %}
    </div>
  </div>
</section>
{% endif %}

<!-- FOOTER -->
<footer>
  <div class="wrap">
    <div class="ftop">
      <span class="wordmark"><span class="mark">R</span><span class="name">Recruitment&nbsp;Suite</span></span>
      <span class="panel-label">{{ 'report.title' | t(language) }}</span>
    </div>
    <div class="fnotes">
      {{ 'report.candidate' | t(language) }}: {{ candidate_name }}<br>
      {{ 'report.job' | t(language) }}: {{ job_title }}{% if job_company %} {{ 'report.at' | t(language) }} {{ job_company }}{% endif %}<br>
      {{ 'report.generated' | t(language) }}: {{ generated_at }}
    </div>
  </div>
</footer>

<script>
  function toggleLayer(head){
    var open=head.closest('.layer').classList.toggle('open');
    head.setAttribute('aria-expanded',open?'true':'false');
  }
</script>
</body>
</html>
